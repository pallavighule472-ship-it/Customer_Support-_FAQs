# OpenAI
OPENAI_API_KEY=your_openai_api_key

# App password (required — set this in Railway Variables)
SETUP_PASSWORD=your_chosen_password

# LangSmith tracing (optional)
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=SwiftHelp
LANGCHAIN_TRACING_V2=true

# Email notifications for support tickets (optional)
SUPPORT_EMAIL=your@email.com
SMTP_SENDER_EMAIL=your@gmail.com
SMTP_APP_PASSWORD=your_gmail_app_password
